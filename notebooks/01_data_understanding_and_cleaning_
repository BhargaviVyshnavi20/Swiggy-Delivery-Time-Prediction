":-330,"elapsed":44,"user":{"displayName":"Bhargavi Vyshnavi Kancharla","userId":"01880163326582014287"}}},"source":["def data_cleaning(df_input: pd.DataFrame) -> pd.DataFrame:\n","    df = df_input.copy()\n","\n","    # Helper function to rename columns\n","    def _change_column_names(data: pd.DataFrame):\n","        return (\n","            data.rename(str.lower, axis=1)\n","                .rename(columns={\n","                    \"delivery_person_id\": \"rider_id\",\n","                    \"delivery_person_age\": \"age\",\n","                    \"delivery_person_ratings\": \"ratings\",\n","                    \"delivery_location_latitude\": \"delivery_latitude\",\n","                    \"delivery_location_longitude\": \"delivery_longitude\",\n","                    \"time_orderd\": \"order_time\",\n","                    \"time_order_picked\": \"order_picked_time\",\n","                    \"weatherconditions\": \"weather\",\n","                    \"road_traffic_density\": \"traffic\",\n","                    \"city\": \"city_type\",\n","                    \"time_taken(min)\": \"time_taken\"\n","                })\n","        )\n","\n","\n","    # Helper function to extract datetime features\n","    def _extract_datetime_features(ser):\n","      date_col = pd.to_datetime(ser, dayfirst=True, errors=\"coerce\")\n","\n","      return pd.DataFrame({\n","          \"order_day\": date_col.dt.day,\n","          \"order_month\": date_col.dt.month,\n","          \"order_year\": date_col.dt.year,\n","          \"order_day_of_week\": date_col.dt.day_name().str.lower(),\n","          \"is_weekend\": date_col.dt.day_name().isin(\n","              [\"Saturday\", \"Sunday\"]\n","          ).astype(int)\n","      })\n","\n","    # Helper function for time of day categorization\n","    def _time_of_day(ser):\n","        time_col = pd.to_datetime(ser, format=\"%H:%M:%S\", errors='coerce').dt.hour\n","\n","        return np.select(\n","            condlist=[\n","                time_col.between(6, 12, inclusive=\"left\"),\n","                time_col.between(12, 17, inclusive=\"left\"),\n","                time_col.between(17, 20, inclusive=\"left\"),\n","                time_col.between(20, 24, inclusive=\"left\"),\n","            ],\n","            choicelist=[\n","                \"morning\",\n","                \"afternoon\",\n","                \"evening\",\n","                \"night\",\n","            ],\n","            default=\"after_midnight\",\n","        )\n","\n","    # Replace \"NaN \" and \"conditions NaN\" strings with actual NaN\n","    df.replace(\"NaN \", np.nan, inplace=True)\n","    df.replace(\"conditions NaN\", np.nan, inplace=True)\n","\n","    # Rename columns\n","    df = _change_column_names(df)\n","\n","    # Drop ID column\n","    df.drop(columns=[\"id\"], errors=\"ignore\", inplace=True)\n","\n","    # Extract city name from rider_id\n","    df[\"city_name\"] = df[\"rider_id\"].str.split(\"RES\").str.get(0)\n","\n","\n","    # Convert and clean data types\n","    df['age'] = df['age'].astype(float)\n","    df['ratings'] = df['ratings'].astype(float)\n","    df['multiple_deliveries'] = df['multiple_deliveries'].astype(float)\n","\n","    # Clean and convert 'time_taken'\n","    df['time_taken'] = (\n","        df['time_taken']\n","        .str.replace(\"(min) \", \"\", regex=False)\n","        .astype(\"int64\")\n","    )\n","\n","    # Clean 'weather' column\n","    df[\"weather\"] = (\n","    df[\"weather\"]\n","    .str.strip()\n","    .str.lower()\n","    .str.replace(\"conditions \", \"\", regex=False)\n",")\n","\n","    # Clean other categorical columns (strip whitespace and lowercase)\n","    for col in ['traffic', 'type_of_order', 'type_of_vehicle', 'festival', 'city_type']:\n","        df[col] = df[col].str.strip().str.lower()\n","\n","    # Process order_date and time\n","    # Convert order_date to datetime\n","    df[\"order_date\"] = pd.to_datetime(df[\"order_date\"], dayfirst=True, errors=\"coerce\")\n","\n","    # Extract date features\n","    date_features_df = _extract_datetime_features(df[\"order_date\"])\n","    # Add new columns while keeping order_date\n","    df = pd.concat([df, date_features_df], axis=1)\n","\n","\n","    time_subset_processed = (\n","        df[['order_time', 'order_picked_time']].copy()\n","        .assign(\n","            **{\n","                col: pd.to_datetime(\n","                    df[col].replace(\"NaN\", np.nan).dropna(),\n","                    format=\"%H:%M:%S\", errors='coerce'\n","                )\n","                for col in ['order_time', 'order_picked_time']\n","            }\n","        )\n","        .assign(\n","            # Pickup time in minutes\n","            pickup_time=lambda x: (\n","            (\n","            x[\"order_picked_time\"].where(\n","            x[\"order_picked_time\"] >= x[\"order_time\"],\n","            x[\"order_picked_time\"] + pd.Timedelta(days=1)\n","            )\n","            - x[\"order_time\"]\n","        )   .dt.total_seconds() / 60\n","            ),\n","            order_time_hour=lambda x: x[\"order_time\"].dt.hour,\n","            order_time_of_day=lambda x: x[\"order_time\"].pipe(_time_of_day),\n","        )\n","        .drop(columns=[\"order_time\", \"order_picked_time\"])\n","    )\n","    df = pd.concat([df, time_subset_processed], axis=1)\n","\n","    # Drop rows based on defined criteria\n","    # India geographical bounds\n","    min_lat = 8.0 + 4/60\n","    max_lat = 37.0 + 6/60\n","    min_long = 68.0 + 7/60\n","    max_long = 97.0 + 25/60\n","\n","    # Filter out minors, 6-star ratings, and out-of-bounds locations\n","    initial_rows = df.shape[0]\n","    df = df.loc[df['age'] >= 18] # Remove minors\n","    df = df.loc[df['ratings'] != 6.0] # Remove 6-star ratings\n","\n","    # Remove rows with restaurant or delivery coordinates outside India's mainland\n","    df = df.loc[\n","        (df['restaurant_latitude'] >= min_lat) & (df['restaurant_latitude'] <= max_lat) &\n","        (df['restaurant_longitude'] >= min_long) & (df['restaurant_longitude'] <= max_long) &\n","        (df['delivery_latitude'] >= min_lat) & (df['delivery_latitude'] <= max_lat) &\n","        (df['delivery_longitude'] >= min_long) & (df['delivery_longitude'] <= max_long)\n","    ]\n","\n","\n","    from geopy.distance import geodesic\n","\n","    df[\"distance_km\"] = df.apply(\n","        lambda row: geodesic(\n","            (row[\"restaurant_latitude\"], row[\"restaurant_longitude\"]),\n","            (row[\"delivery_latitude\"], row[\"delivery_longitude\"])\n","        ).km,\n","        axis=1,\n","    )\n","\n","    df[\"distance_type\"] = pd.cut(\n","        df[\"distance_km\"],\n","        bins=[0, 5, 10, 20, np.inf],\n","        labels=[\"short\", \"medium\", \"long\", \"very_long\"],\n","        include_lowest=True,\n","    )\n","    final_rows = df.shape[0]\n","    print(f\"Removed {initial_rows - final_rows} rows due to cleaning criteria (minors, 6-star ratings, invalid coordinates).\")\n","\n","    return df"],"execution_count":90,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"74934384"},"source":["Now, let's apply the `data_cleaning` function to our DataFrame and display the first few rows of the cleaned data, along with its information to check data types."]},{"cell_type":"code","metadata":{"id":"8285fc3b","colab":{"base_uri":"https://localhost:8080/","height":943},"executionInfo":{"status":"ok","timestamp":1785497146729,"user_tz":-330,"elapsed":9843,"user":{"displayName":"Bhargavi Vyshnavi Kancharla","userId":"01880163326582014287"}},"outputId":"fe631383-159c-4b51-8c35-9e804ea0b539"},"source":["df_cleaned = data_cleaning(df.copy())\n","display(df_cleaned.head())\n","df_cleaned.info()"],"execution_count":91,"outputs":[{"output_type":"stream","name":"stdout","text":["Removed 5596 rows due to cleaning criteria (minors, 6-star ratings, invalid coordinates).\n"]},{"output_type":"display_data","data":{"text/plain":["     